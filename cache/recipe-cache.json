          {
            "risk": "内存溢出",
            "probability": "中",
            "impact": "中",
            "mitigation": "分批处理、使用 Dask、采样分析"
          }
        ]
      },
      "step_5_execution": {
        "key_milestones": [
          {
            "milestone": "数据加载完成",
            "checkpoint": "数据成功读取且格式正确"
          },
          {
            "milestone": "探索性分析完成",
            "checkpoint": "理解数据分布和特征"
          },
          {
            "milestone": "核心分析完成",
            "checkpoint": "关键问题已回答"
          },
          {
            "milestone": "可视化完成",
            "checkpoint": "生成所需图表"
          }
        ]
      },
      "step_6_verification": {
        "verification_checklist": [
          "✅ 分析结果可复现",
          "✅ 可视化清晰准确",
          "✅ 代码可运行",
          "✅ 文档完整"
        ]
      }
