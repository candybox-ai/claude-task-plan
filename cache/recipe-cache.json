  {
    "metadata": {
      "name": "Web Development",
      "version": "2.1.0",
      "description": "通用 Web 应用开发 Recipe，支持 React/Vue/Angular 前端和 Node.js/Python 后端",
      "category": "development",
      "tags": [
        "web",
        "frontend",
        "backend",
        "fullstack",
        "api"
      ],
      "author": "claude-agent-dispatch",
      "created_at": "2025-01-11",
      "updated_at": "2025-01-11"
    },
    "triggers": {
      "keywords": [
        "React",
        "Vue",
        "Angular",
        "Svelte",
        "Next.js",
        "Nuxt",
        "Express",
        "FastAPI",
        "Django",
        "Flask",
        "API",
        "REST",
        "GraphQL",
        "前端",
        "后端",
        "全栈",
        "网站",
        "Web应用",
        "单页应用",
        "SPA"
      ],
      "patterns": [
        "构建.*网站",
        "开发.*应用",
        "实现.*功能",
        "build.*app",
        "develop.*website",
        "create.*dashboard"
      ]
    },
    "workflow": {
      "step_1_clarification": {
        "priority_questions": [
          "🎨 前端框架偏好？（React/Vue/Angular/其他）",
          "🖥️  是否需要后端 API？如果需要，使用什么技术栈？",
          "📱 目标平台？（桌面浏览器/移动端/两者）",
          "🎯 关键功能优先级排序？",
          "🔐 是否需要用户认证？（JWT/OAuth/Session）",
          "💾 数据存储需求？（数据库类型、数据模型）",
          "🚀 部署目标？（Vercel/Netlify/AWS/自托管）"
        ],
        "tech_stack_discovery": [
          "现有代码库位置？",
          "是否有设计稿或原型？",
          "API 文档或数据结构说明？"
        ],
        "constraints": [
          "浏览器兼容性要求？",
          "性能指标要求？（Lighthouse 分数、加载时间）",
          "预算或时间限制？"
        ]
      },
      "step_2_criteria": {
        "success_criteria": {
          "functional": [
            "所有指定功能正常工作且通过测试",
            "用户流程完整且符合预期",
            "错误处理和边界情况覆盖"
          ],
          "technical": [
            "代码符合团队/社区最佳实践",
            "适当的代码注释和文档",
            "类型安全（如使用 TypeScript）"
          ],
          "performance": [
            "首次内容绘制 (FCP) < 1.8s",
            "最大内容绘制 (LCP) < 2.5s",
            "累积布局偏移 (CLS) < 0.1",
            "首次输入延迟 (FID) < 100ms",
            "Lighthouse Performance 分数 > 90"
          ],
          "quality": [
            "无严重安全漏洞（npm audit / pip check）",
            "无 ESLint/Prettier 错误",
            "测试覆盖率 > 70%（关键路径 100%）"
          ],
          "ux": [
            "响应式设计，支持移动端和桌面端",
            "Loading 状态和错误提示清晰",
            "符合 WCAG 2.1 AA 无障碍标准"
          ]
        },
        "quality_indicators": [
          "✅ 代码可读性和可维护性",
          "✅ 适当的组件/模块划分",
          "✅ 状态管理清晰合理",
          "✅ API 设计符合 RESTful 或 GraphQL 规范"
